# omp-deck production environment — copy to `.env`, fill in, and source
# (or pass via `docker compose --env-file`).
#
# `MCP_OPENSHIP_TOKEN` is the only secret the deck REQUIRES to be useful
# for the "develop in the deck, push to GitHub, deploy to OpenShip"
# loop. The provider keys below are needed only if you want the
# in-deck agent to actually run prompts — the deck itself (UI, file
# explorer, marketplace, prompts library) works without them.

# ─── OpenShip bridge ──────────────────────────────────────────────────────
# Bearer token used by the deck's /api/openship/* routes to talk to the
# OpenShip MCP at https://ship.v244.net/api/proxy/api/mcp. Get one from
# the OpenShip dashboard. Without this, those routes return 503 and the
# OpenShip panel in /integrations shows a "connect OpenShip" hint.
MCP_OPENSHIP_TOKEN=

# ─── Provider keys (in-deck agent only) ───────────────────────────────────
# At minimum set one. The deck uses whichever the active model picker
# selects; the others are unused cost-free.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: GitHub PAT for the in-deck GitHub panel (clone, push, PR).
# Without it, the GitHub routes return 401 — the rest of the deck still
# works, you just can't push/PR from inside.
GITHUB_TOKEN=

# ─── Workspace + ports ────────────────────────────────────────────────────
# Host path that becomes /workspace inside the container. The agent
# shells into here. Default: ./workspace (relative to where you run
# `docker compose`).
OMP_DECK_WORKSPACE=./workspace

# Default cwd the agent lands in when starting a session, when the user
# does not override. Must exist inside the container.
OMP_DECK_DEFAULT_CWD=/workspace

# Host port the server binds. Internal port stays 8787.
OMP_DECK_PORT=8787

# ─── Diagnostics ──────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info
