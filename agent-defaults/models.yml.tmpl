providers:
  # FAST tier providers (cerebras + anthropic are built-in — need only API keys in secrets/env)
  groq:
    baseUrl: https://api.groq.com/openai/v1
    apiKey: ${OMP_PROVIDER_GROQ_API_KEY}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list

  # official Inception Labs endpoint (your old `inception` went through omnirouter proxy)
  inception:
    baseUrl: https://api.inceptionlabs.ai/v1
    apiKey: ${OMP_PROVIDER_INCEPTION_API_KEY}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list

  codexhub:
    baseUrl: https://api.codexhub.click/v1
    apiKey: ${OMP_PROVIDER_CODEXHUB_API_KEY}
    api: openai-completions
    models:
    - id: deepseek-v4-pro
      contextWindow: 1000000
      description: "Best reasoning capability"
    - id: deepseek-v4-flash
      contextWindow: 1000000
      description: "Fastest model"

  9router:
    baseUrl: https://9router.v244.net/v1
    apiKey: ${OMP_PROVIDER_9ROUTER_API_KEY}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list

  # Legacy Inception route via the omnirouter proxy. Kept reachable under a
  # distinct key — a second `inception:` mapping made the whole models.yml
  # unparseable (`YAMLParseError: Map keys must be unique`), which put
  # `custom-providers` into a once-a-second reload-and-fail loop in
  # production. The official endpoint above owns the `inception` name.
  inception-omnirouter:
    baseUrl: https://omnirouter.v244.net/api/v1
    apiKey: ${OMP_PROVIDER_INCEPTION_API_KEY}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list

  omni:
    baseUrl: https://omni.v244.net/v1
    apiKey: ${OMP_PROVIDER_OMNI_API_KEY}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list

  open-go:
    baseUrl: https://opencode.ai/zen/go/v1
    apiKey: ${OMP_PROVIDER_OPEN_GO_API_KEY}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list

  gepete:
    baseUrl: https://bandelbanget.xyz/v1
    apiKey: ${OMP_PROVIDER_GEPETE_API_KEY}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list

# nghimmo has been replaced by `ngh-claude` below — this block kept for reference during migration (different key).

  ngh-claude:
    baseUrl: https://api.nghimmo.com/v1
    apiKey: ${OMP_PROVIDER_NGH_CLAUDE_API_KEY}
    api: openai-completions
    authHeader: true
    models:
    - id: nghi/claude-opus-4.8
      contextWindow: 200000
    - id: nghi/claude-opus-4.8-thinking
      contextWindow: 200000
